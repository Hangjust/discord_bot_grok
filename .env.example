# Keep local dotenv output quiet
DOTENV_CONFIG_QUIET=true

# Bootstrap Discord settings
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_numeric_application_id_here

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GUILD_CONFIG_MASTER_KEY=
GUILD_CONFIG_MASTER_KEY_ID=primary
GUILD_CONFIG_PATH=./data/guild-config.json
USER_MEMORY_PATH=./data/user-memory.ndjson

# Deployment-wide provider behavior and request limits
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_MS=30000
DEEPSEEK_MAX_CONCURRENT_PER_GUILD=2
DEEPSEEK_MAX_REQUESTS_PER_GUILD_PER_MINUTE=40
DEEPSEEK_MAX_REQUESTS_PER_USER_PER_MINUTE=8
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT_MS=5000

# Optional deployment-wide prompt helper
PROTECTED_GLAZE_USER_IDS=

# Explicit legacy environment fallback (normally keep false)
ALLOW_LEGACY_GUILD_CONFIG=false
DEEPSEEK_API_KEY=
DISCORD_READ_EXCLUDED_CHANNEL_IDS=
DISCORD_REPLY_ALLOWED_CHANNEL_IDS=
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=
